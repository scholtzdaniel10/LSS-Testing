{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lss.dev/schemas/diagnostic-error.schema.json",
  "title": "Diagnostic error (contract C5)",
  "description": "DX-22: source is now a free string validated at runtime against the adapter registry \u2014 not a closed enum. Any registered adapter id is valid.",
  "type": "object",
  "required": [
    "id",
    "source",
    "ruleId",
    "kind",
    "severity",
    "file",
    "range",
    "message"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "DX-22: open string \u2014 validated against the AnalyzerRegistry at runtime, not a closed enum here."
    },
    "ruleId": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "type-error",
        "null-risk",
        "missing-dep",
        "contract-mismatch",
        "unused",
        "security",
        "other"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "range": {
      "type": "object",
      "required": [
        "startLine",
        "startCol",
        "endLine",
        "endCol"
      ],
      "additionalProperties": false,
      "properties": {
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "startCol": {
          "type": "integer",
          "minimum": 0
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endCol": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "message": {
      "type": "string"
    },
    "explanation": {
      "type": "string",
      "description": "Plain-language, from the taxonomy (DX-5)."
    },
    "upstream": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "downstream": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
