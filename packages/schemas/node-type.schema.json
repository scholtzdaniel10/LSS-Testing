{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lss.dev/schemas/node-type.schema.json",
  "title": "Node-type definition (contract C2)",
  "type": "object",
  "required": ["type", "category", "propsSchema", "allowedChildren", "renderer"],
  "additionalProperties": false,
  "properties": {
    "type": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "enum": ["structure", "ui", "data"] },
    "propsSchema": {
      "type": "object",
      "description": "A JSON Schema validating this node type's props object."
    },
    "allowedChildren": {
      "oneOf": [
        { "type": "string", "enum": ["*", "none"] },
        { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      ]
    },
    "renderer": {
      "type": "string",
      "minLength": 1,
      "description": "Key into packages/renderer's registry."
    }
  }
}
