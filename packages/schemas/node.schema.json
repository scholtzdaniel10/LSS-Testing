{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lss.dev/schemas/node.schema.json",
  "title": "Node (contract C1)",
  "type": "object",
  "required": ["id", "type", "name", "props", "events", "children"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "props": {
      "type": "object",
      "description": "Validated against the node type's propsSchema (contract C2) at save time."
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trigger", "action"],
        "additionalProperties": false,
        "properties": {
          "trigger": { "type": "string", "enum": ["click", "change", "submit", "load"] },
          "action": { "type": "string", "enum": ["navigate", "call-api", "set-state"] },
          "args": { "type": "object" }
        }
      }
    },
    "children": {
      "type": "array",
      "items": { "$ref": "#" }
    }
  }
}
