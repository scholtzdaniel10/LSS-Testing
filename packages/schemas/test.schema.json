{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lss.dev/schemas/test.schema.json",
  "title": "Browser test (contract C6)",
  "type": "object",
  "required": ["id", "projectId", "targetEnvId", "name", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "projectId": { "type": "string", "format": "uuid" },
    "targetEnvId": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action", "target"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "action": { "type": "string", "enum": ["navigate", "click", "fill", "expectVisible", "expectText"] },
          "target": {
            "type": "object",
            "required": ["selector"],
            "additionalProperties": false,
            "properties": {
              "selector": {
                "type": "string",
                "minLength": 1,
                "description": "Preference order: data-testid > role/text > css (TST-5)."
              }
            }
          },
          "value": { "type": "string", "description": "Required for fill and expectText." }
        }
      }
    }
  }
}
