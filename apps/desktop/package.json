{
  "name": "lss-desktop",
  "version": "0.1.0",
  "description": "Electron wrapper for LSS Maintenance System",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "au.com.lss.maintenance-system",
    "productName": "LSS Maintenance System",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "db-config.js",
      "api-process.js",
      "db-setup.html",
      "db-setup-renderer.js",
      "../web/dist/**"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
