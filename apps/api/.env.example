APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=lss
# DB_USERNAME=lss
# DB_PASSWORD=lss

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Tier 1 (no Redis): database queue — run `php artisan queue:listen --timeout=660`
# Single-process / tests: sync (phpunit.xml forces sync)
# With Redis: QUEUE_CONNECTION=redis and CACHE_STORE=redis
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

# Speed layer (Tier 1 works without Redis)
# PHPSTAN_SHARDS=true
# PHPSTAN_DEEP=false
# PHPSTAN_CACHE_DIR=true
# SPEED_INCREMENTAL_GRAPH=true
# SPEED_FINDINGS_BUFFER=false
# SPEED_SKIP_USAGE_REBUILD=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Sandbox — local folder linking (IG-1 / PLT security)
# ---------------------------------------------------------------------------
# Set to true only on a single-user workstation deployment; keep false (default)
# on any shared or hosted API instance.
# SANDBOX_ALLOW_LOCAL_LINK=false

# Semicolon-separated list of absolute path prefixes that are permitted as
# local link roots. When empty (default) ALL local paths are rejected even if
# SANDBOX_ALLOW_LOCAL_LINK=true, so you must configure at least one prefix to
# use local linking. Example: C:\LSS;C:\Projects
# LOCAL_PATH_PREFIXES=
